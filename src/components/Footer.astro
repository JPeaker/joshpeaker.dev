---
import { SITE, LINKEDIN, GITHUB } from "@consts"
import Container from "@components/Container.astro"

const year = new Date().getFullYear()
---

<footer class="relative bg-white dark:bg-black border-t border-black/10 dark:border-white/25">
  <Container size="md">
    <div class="flex flex-col items-center justify-center gap-2 py-4">
      <div class="flex items-center gap-x-3 text-xs">
        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="hover:opacity-100 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out">
          LinkedIn
        </a>
        <span>·</span>
        <a href={GITHUB} target="_blank" rel="noopener noreferrer" class="hover:opacity-100 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out">
          GitHub
        </a>
      </div>
      <p class="text-xs opacity-60">
        &copy; {year} {SITE.TITLE}
      </p>
    </div>
  </Container>
</footer>
