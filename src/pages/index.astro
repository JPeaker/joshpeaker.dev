---
import PageLayout from "@layouts/PageLayout.astro"
import { SITE, EMAIL } from "@consts"
---

<PageLayout title={SITE.TITLE} description={SITE.DESCRIPTION}>

  <div class="relative flex-1 flex flex-col justify-center">
    <div class="mx-auto w-full max-w-screen-sm p-6">

      <!-- HERO -->
      <section class="animate text-center">
        <p class='text-sm md:text-base lg:text-lg font-semibold opacity-75'>
          Freelance Senior Full Stack Engineer
        </p>
        <h1 class='mt-2 text-4xl md:text-5xl font-bold uppercase text-black dark:text-white'>
          {SITE.TITLE}
        </h1>
        <p class='text-sm md:text-base lg:text-lg opacity-75'>
          Node.js, C# .NET, TypeScript &amp; React
        </p>
      </section>

      <!-- Pitch -->
      <section class="animate mt-12">
        <p class="font-semibold text-black dark:text-white">
          Who I am
        </p>
        <p class="mt-3">
          I've been shipping software for around 12 years, mostly focused on end-to-end products and the systems supporting them, whether that's React interfaces or backend services. At <strong>monday.com</strong> I built the Node.js services behind WorkForms, then rebuilt the frontend around them. At <strong>Snyk</strong> I worked across the REST and GraphQL APIs and the data-dense dashboards that read from them. I'm happy all the way from the database through to the UI.
        </p>
      </section>

      <!-- Capabilities -->
      <section class="animate mt-12">
        <p class="font-semibold text-black dark:text-white">
          What I work with
        </p>
        <dl class="mt-3 space-y-4 text-sm">
          <div>
            <dt class="font-semibold text-black dark:text-white">Frontend &amp; frameworks</dt>
            <dd class="mt-1">
              React &amp; Next.js &middot; Vue &middot; Complex state management &middot; Component libraries &middot; accessibility &middot; Performance optimisation
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-black dark:text-white">Backend &amp; cloud</dt>
            <dd class="mt-1">
              Node.js &amp; TypeScript, C# .NET Core &middot; REST &amp; GraphQL API design &middot; NestJS &amp; Express &middot; Database design &amp; migrations &middot; Microservices &amp; real-time systems &middot; AWS &amp; Azure
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-black dark:text-white">Engineering practices</dt>
            <dd class="mt-1">
              End-to-end product delivery &middot; Monolith &amp; platform migrations &middot; Type safety across layers &middot; CI/CD
            </dd>
          </div>
        </dl>
      </section>

      <!-- CTA -->
      <section class="animate mt-12">
        <p class="font-semibold text-black dark:text-white">
          Now accepting projects for Q4 2026 and Q1 2027
        </p>
        <p class="mt-2">
          If you need help on one of your projects, get in touch and let's chat!
        </p>
        <div class="mt-5 justify-center flex flex-wrap">
          <a href={`mailto:${EMAIL}`} class='py-2.5 px-6 rounded text-xs md:text-sm lg:text-base bg-black dark:bg-white text-white dark:text-black hover:opacity-75 blend'>
            Get in touch
          </a>
        </div>
        <p class="mt-3 text-center text-sm opacity-60">
          {EMAIL}
        </p>
      </section>

    </div>
  </div>
</PageLayout>
